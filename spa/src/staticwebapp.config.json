{
  "routes": [
    {
      "route": "/ngsw.json",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/ngsw-worker.js",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,scss,js,png,ico,webmanifest}"]
  }
}
